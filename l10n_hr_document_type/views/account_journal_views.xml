<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_account_journal_form" model="ir.ui.view">
        <field name="name">view_account_journal_form</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="l10n_hr_codebook.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='croatian_fiscal_2_codebooks']//group[@name='codebook_data']//group[@name='right']"
                   position="inside">
                <field name="l10n_hr_untdid1001_document_type_id"/>
            </xpath>
        </field>
    </record>

</odoo>
