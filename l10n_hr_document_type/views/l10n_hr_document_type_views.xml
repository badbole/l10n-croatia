<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="l10n_hr_document_type_list_view" model="ir.ui.view">
        <field name="name">l10n.hr.document.type.list</field>
        <field name="model">l10n.hr.document.type</field>
        <field name="arch" type="xml">
            <tree string="Document Types">
                <field name="code"/>
                <field name="name"/>
                <field name="display_name"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <record id="l10n_hr_document_type_form_view" model="ir.ui.view">
        <field name="name">l10n.hr.document.type.form</field>
        <field name="model">l10n.hr.document.type</field>
        <field name="arch" type="xml">
            <form string="Document Type">
                <sheet>
                    <div class="oe_title">
                        <h5>
                            Document Type
                        </h5>
                        <h1>
                            <field name="display_name" nolabel="1"/>
                        </h1>
                    </div>
                    <group name="data" string="Document Type Data">
                        <group name="code">
                            <field name="code"/>
                        </group>
                        <group name="name">
                            <field name="name"/>
                        </group>
                    </group>
                    <group name="type_description">
                        <field name="description"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="l10n_hr_document_type_action" model="ir.actions.act_window">
        <field name="name">UNTDID1001 Document Types</field>
        <field name="res_model">l10n.hr.document.type</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
