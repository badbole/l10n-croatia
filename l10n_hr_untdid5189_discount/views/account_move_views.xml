<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="l10n_hr_dicount_view_move_form" model="ir.ui.view">
        <field name="name">l10n_hr_dicount_view_move_form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='discount']" position="before">
                <field name="l10n_hr_discount_type_id" optional="show"
                       attrs="{'required': [('discount','!=' , 0.0)]}"  />
            </xpath>
        </field>
    </record>

</odoo>
