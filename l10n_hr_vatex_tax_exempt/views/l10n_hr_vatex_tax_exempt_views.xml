<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="l10n_hr_vatex_tax_exempt_list_view" model="ir.ui.view">
        <field name="name">l10n.hr.vatex.tax.exempt.list</field>
        <field name="model">l10n.hr.vatex.tax.exempt</field>
        <field name="arch" type="xml">
            <tree string="VATEX Tax Exempts">
                <field name="code"/>
                <field name="name"/>
                <field name="display_name"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <record id="l10n_hr_vatex_tax_exempt_form_view" model="ir.ui.view">
        <field name="name">l10n.hr.vatex.tax.exempt.form</field>
        <field name="model">l10n.hr.vatex.tax.exempt</field>
        <field name="arch" type="xml">
            <form string="VATEX Tax Exempt">
                <sheet>
                    <div class="oe_title">
                        <h5>
                            VATEX Tax Exempt
                        </h5>
                        <h1>
                            <field name="display_name" nolabel="1"/>
                        </h1>
                    </div>
                    <group name="data" string="Tax Exempt Data">
                        <group name="code">
                            <field name="code"/>
                        </group>
                        <group name="name">
                            <field name="name"/>
                        </group>
                    </group>
                    <group name="exempt_description">
                        <field name="description"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="l10n_hr_vatex_tax_exempt_action" model="ir.actions.act_window">
        <field name="name">VATEX Tex Exempt</field>
        <field name="res_model">l10n.hr.vatex.tax.exempt</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
