<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_tax_form" model="ir.ui.view">
        <field name="name">l10n_hr_vatex_tax_exempt.view_tax_form</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="l10n_hr_codebook.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='croatian_fiscal_2_codebooks']//group[@name='codebook_data']//group[@name='right']"
                   position="inside">
                <field name="l10n_hr_vatex_tax_exempt_id"
                        attrs="{
                        'invisible': [('is_exempt_required', '=', False)],
                        'required': [('is_exempt_required', '=', True)]
                        }"/>
                <field name="is_exempt_required" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
