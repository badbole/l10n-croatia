<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="l10n_hr_business_process_type_list_view" model="ir.ui.view">
        <field name="name">l10n.hr.business.process.type.list</field>
        <field name="model">l10n.hr.business.process.type</field>
        <field name="arch" type="xml">
            <tree string="Business Process Types">
                <field name="code"/>
                <field name="name"/>
                <field name="display_name"/>
            </tree>
        </field>
    </record>

    <record id="l10n_hr_business_process_type_form_view" model="ir.ui.view">
        <field name="name">l10n.hr.business.process.type.form</field>
        <field name="model">l10n.hr.business.process.type</field>
        <field name="arch" type="xml">
            <form string="Business Process Type">
                <sheet>
                    <div class="oe_title">
                        <h5>
                            Business Process Type
                        </h5>
                        <h1>
                            <field name="display_name" nolabel="1"/>
                        </h1>
                    </div>
                    <group name="data" string="Business Process Type Data">
                        <group name="code">
                            <field name="code"/>
                        </group>
                        <group name="name">
                            <field name="name"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="l10n_hr_business_process_type_action" model="ir.actions.act_window">
        <field name="name">Business Process Types</field>
        <field name="res_model">l10n.hr.business.process.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
