<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="l10n_hr_kpd_view_move_form" model="ir.ui.view">
        <field name="name">l10n_hr_kpd_view_move_form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='price_total']" position="after">
                <field name="l10n_hr_kpd_id" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
