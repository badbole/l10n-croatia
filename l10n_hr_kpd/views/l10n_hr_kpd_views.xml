<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="l10n_hr_kpd_list_view" model="ir.ui.view">
        <field name="name">l10n.hr.kpd.list</field>
        <field name="model">l10n.hr.kpd</field>
        <field name="arch" type="xml">
            <tree string="KPDs">
                <field name="code"/>
                <field name="level" optional="hide"/>
                <field name="name"/>
                <field name="type"/>
                <field name="parent_id"/>
                <field name="date_start" optional="hide"/>
                <field name="date_end" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="l10n_hr_kpd_form_view" model="ir.ui.view">
        <field name="name">l10n.hr.kpd.form</field>
        <field name="model">l10n.hr.kpd</field>
        <field name="arch" type="xml">
            <form string="KPD">
                <sheet>
                    <group name="name">
                        <field name="name"/>
                    </group>
                    <group name="data" string="Subcategory Data">
                        <group name="left">
                            <field name="code"/>
                            <field name="level"/>
                            <field name="type"/>
                        </group>
                        <group name="right">
                            <field name="parent_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="l10n_hr_kpd_search_view" model="ir.ui.view">
        <field name="name">l10n.hr.kpd.search.view</field>
        <field name="model">l10n.hr.kpd</field>
        <field name="priority" eval="300"/>
        <field name="arch" type="xml">
            <search string="Search KPDs">
                <field name="code"/>
                <field name="name"/>
                <separator/>
                <filter string="Type" name="group_by_type" domain="[]" context="{'group_by': 'type'}"/>
                <separator/>
                <filter string="KPDs" name="filter_subcategory_kpd" domain="[('type', '=', '6')]"/>
            </search>
        </field>
    </record>

    <record id="l10n_hr_kpd_action" model="ir.actions.act_window">
        <field name="name">KPDs</field>
        <field name="res_model">l10n.hr.kpd</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_filter_subcategory_kpd":1,}</field>
    </record>

</odoo>
